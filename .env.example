# Copy to .env and fill in. .env is gitignored — never commit real values.

# Required: the long-lived refresh token printed when you first authorize.
# Get one with the Authorization Code + PKCE flow (scopes:
# playlist-modify-public playlist-modify-private user-read-private).
SPOTIFY_REFRESH_TOKEN=

# Optional: defaults to the app's public client id. Set if you use your own
# Spotify app. No client secret is needed — rebuild.py uses the PKCE grant.
# SPOTIFY_CLIENT_ID=72e5fca8b6d34b3b912ddd620c2c2bd3

# Required for scraping (unless you pass --queries-file): your Anthropic key,
# used so Claude can extract the tracklist from the BBC page.
ANTHROPIC_API_KEY=

# Optional: override the playlist name.
# PLAYLIST_NAME=BBC 1xtra badman ting
